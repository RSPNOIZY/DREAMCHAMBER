# ═══════════════════════════════════════════════════════════════════════════
# NOIZY EMPIRE .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example
*.pem
*.key
*.secret
credentials.json

# Dependencies
node_modules/
dreamchamber/node_modules/
.npm/

# Wrangler local state
.wrangler/

# Build output
dist/
build/
*.js.map

# Logs
*.log
logs/
dreamchamber/*.log
dreamchamber/logs/
npm-debug.log*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.idea/
# .vscode/ is tracked (project-level tasks, settings, extensions)
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/
*.venv*/
.venv*/

# Deployment artifacts (generated)
deployments.json
audit-log.json
.version.json

# Empire docs (OneDrive mirror — large, not source code)
docs/empire/

# Large files
archivist_catalog.json
*.dylib

# Test coverage
coverage/
.nyc_output/

# Temp files
tmp/
temp/
*.tmp

# WireGuard keys (NEVER COMMIT)
privatekey
publickey
*.wgkey
*.wgpub
**/privatekey
**/publickey

# Postman local state
.postman/

# ═══════════════════════════════════════════════════════════════════════════
# HEAVY DIRECTORIES — DO NOT COMMIT (added 2026-04-08)
# ═══════════════════════════════════════════════════════════════════════════

# OneDrive mirror — 12GB music career archive, NOT source code
OneDrive/

# NOIZYEMPIRE Go monolith — 55K files, 1.6GB, tracked separately
# Uncomment below ONLY after running: git rm -r --cached NOIZYEMPIRE/
NOIZYEMPIRE/

# Duplicate/archive directories
DUPES/

# Database files (binary, not diffable)
*.db
*.sqlite
*.sqlite3
!schema.sql
!seed.sql

# Gabriel database (binary)
gabriel.db

# VS Code workspace files (user-local, not shared)
*.code-workspace

# Binary documents in tracked dirs
*.docx

# Compressed files (from Go module cache)
*.gz
ops/.env.integrations
.secrets-audit.log
*.p12
.docker/
*.mdb
**/.build/

# Recovery keys (NEVER COMMIT)
.noizy/
recovery-keys/

# Cloudflare tunnel credentials
.cloudflared/*.json
.cloudflared/cert.pem

# Audio recordings (binary, large)
*.wav
*.aiff
*.flac
*.mp3
*.m4a
!**/*.wav.example

# Swift build artifacts
DerivedData/
*.xcuserstate
*.xcuserdatad/

# Recovery output (generated, machine-specific)
Recovered/
