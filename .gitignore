# ═══════════════════════════════════════════════════════════════════════════
# NOIZY EMPIRE .gitignore
# ═══════════════════════════════════════════════════════════════════════════

# Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
.dev.vars
!.dev.vars.example
*.pem
*.key
*.secret
credentials.json

# Dependencies
node_modules/
dreamchamber/node_modules/
.npm/

# Wrangler local state
.wrangler/

# Build output
dist/
build/
*.js.map

# Logs
*.log
logs/
dreamchamber/*.log
dreamchamber/logs/
npm-debug.log*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/
*.venv*/
.venv*/

# Deployment artifacts (generated)
deployments.json
audit-log.json
.version.json

# Empire docs (OneDrive mirror — large, not source code)
docs/empire/

# Large files
archivist_catalog.json
*.dylib

# Test coverage
coverage/
.nyc_output/

# Temp files
tmp/
temp/
*.tmp

# WireGuard keys (NEVER COMMIT)
privatekey
publickey
*.wgkey
*.wgpub
**/privatekey
**/publickey
