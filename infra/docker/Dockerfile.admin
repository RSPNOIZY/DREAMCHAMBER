# ═══════════════════════════════════════════════════════════════
# NOIZY EMPIRE — Admin CLI Toolkit
# All infrastructure tools in one container
# ═══════════════════════════════════════════════════════════════

FROM node:20-bookworm-slim

LABEL maintainer="rsp@noizy.ai"
LABEL description="NOIZY Empire Admin Toolkit"

# System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    jq \
    dnsutils \
    whois \
    openssl \
    ca-certificates \
    gnupg \
    python3 \
    python3-pip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Wrangler (Cloudflare CLI)
RUN npm install -g wrangler@latest

# Terraform
RUN wget -q https://releases.hashicorp.com/terraform/1.7.5/terraform_1.7.5_linux_amd64.zip \
    && unzip terraform_1.7.5_linux_amd64.zip -d /usr/local/bin/ \
    && rm terraform_1.7.5_linux_amd64.zip

# Google Cloud CLI
RUN echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
    | tee /etc/apt/sources.list.d/google-cloud-sdk.list \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
    | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update && apt-get install -y google-cloud-cli \
    && rm -rf /var/lib/apt/lists/*

# Newman (Postman CLI)
RUN npm install -g newman

# Admin scripts
COPY scripts/ /usr/local/bin/noizy/
RUN chmod +x /usr/local/bin/noizy/*

# Shell config
RUN echo 'alias ll="ls -la"' >> /root/.bashrc \
    && echo 'alias status="bash /usr/local/bin/noizy/status.sh"' >> /root/.bashrc \
    && echo 'alias scan="bash /usr/local/bin/noizy/dns-scan.sh"' >> /root/.bashrc \
    && echo 'alias deploy="bash /usr/local/bin/noizy/deploy.sh"' >> /root/.bashrc \
    && echo 'echo "═══ NOIZY Admin Toolkit ═══"' >> /root/.bashrc \
    && echo 'echo "Commands: status, scan, deploy"' >> /root/.bashrc \
    && echo 'echo "═══════════════════════════"' >> /root/.bashrc

WORKDIR /workspace

CMD ["/bin/bash"]
