{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DreamChamber: Start Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/dreamchamber" },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "DreamChamber: Install Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/dreamchamber" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Heaven: Deploy Worker",
      "type": "shell",
      "command": "bash deploy.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Heaven: Smoke Tests",
      "type": "shell",
      "command": "bash smoke_test.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Heaven: Health Check",
      "type": "shell",
      "command": "curl -s https://heaven.noizylab.workers.dev/health | python3 -m json.tool",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "DreamChamber: Health Check",
      "type": "shell",
      "command": "curl -s http://localhost:7777/health | python3 -m json.tool",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "DB: Apply Schema (Remote D1)",
      "type": "shell",
      "command": "npx wrangler d1 execute gabriel_db --remote --file=schema.sql",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "DB: Seed Data (Remote D1)",
      "type": "shell",
      "command": "npx wrangler d1 execute gabriel_db --remote --file=seed.sql",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Voice Bridge: Start",
      "type": "shell",
      "command": "node voice-bridge-server.js",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Git: Status",
      "type": "shell",
      "command": "git status && git log --oneline -10",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Smoke Test: Full Suite",
      "type": "shell",
      "command": "bash smoke_test.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "GABRIEL: Start Daemon (9777)",
      "type": "shell",
      "command": "GABRIEL_PORT=9777 N8N_API_KEY=${N8N_API_KEY} node GABRIEL/daemon/gabriel-daemon.js",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "servers" },
      "problemMatcher": []
    },
    {
      "label": "n8n: Start (API enabled)",
      "type": "shell",
      "command": "N8N_PUBLIC_API_ENABLED=true PATH=\"$HOME/.npm-global/bin:$PATH\" n8n start",
      "group": "build",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "servers" },
      "problemMatcher": []
    },
    {
      "label": "Heaven: Deploy",
      "type": "shell",
      "command": "npx wrangler deploy --env=\"\"",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Heaven: Tail Logs",
      "type": "shell",
      "command": "npx wrangler tail heaven --format pretty",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Recovery: Full Pipeline",
      "type": "shell",
      "command": "make operate",
      "options": { "cwd": "${workspaceFolder}/infra/recovery" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Tunnel: Install (requires cloudflared login)",
      "type": "shell",
      "command": "bash infra/tunnel/install-tunnel.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
