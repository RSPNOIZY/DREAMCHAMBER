{
  // ═══════════════════════════════════════════════════════════════════════════
  // HEAVEN — NOIZY HVS Consent Kernel
  // Cloudflare Worker Config (JSONC — canonical format)
  //
  // Migrated from wrangler.toml → wrangler.jsonc: 2026-04-11
  // Author: RSP_001 (Robert Stephen Plowman)
  // Account: rsp@noizy.ai (5f36aa9795348ea681d0b21910dfc82a)
  //
  // DEPLOY ORDER (separate milestones):
  //   ☐ Heaven source frozen in canonical repo
  //   ☐ Heaven config upgraded to wrangler.jsonc
  //   ☐ Worker deployed (heaven.rsp-5f3.workers.dev)
  //   ☐ noizy.ai zone active (nameservers delegated)
  //   ☐ Custom domain active (heaven.noizy.ai)
  //   ☐ Tunnel + Access live
  //   ☐ Email Routing live
  // ═══════════════════════════════════════════════════════════════════════════

  "name": "heaven",
  "main": "src/index.js",
  "compatibility_date": "2026-04-06",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "5f36aa9795348ea681d0b21910dfc82a",

  // ── Workers AI (Edge Inference) ────────────────────────────────────────────
  // Models: @cf/meta/llama-3.1-8b-instruct, @cf/openai/whisper,
  //         @cf/stabilityai/stable-diffusion-xl-base-1.0
  "ai": {
    "binding": "AI"
  },

  // ── D1 Database ────────────────────────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "GABRIEL_DB",
      "database_name": "gabriel_db",
      "database_id": "a31d68e2-f2d4-4203-a803-8039fdff31cb"
    }
  ],

  // ── R2 Object Storage (Voice Vault) ────────────────────────────────────────
  // BLOCKED: R2 not yet enabled on account. Enable at dash.cloudflare.com > R2
  // Uncomment after enabling:
  // "r2_buckets": [
  //   {
  //     "binding": "VOICE_VAULT",
  //     "bucket_name": "noizy-voice-vault"
  //   }
  // ],

  // ── KV Namespaces ──────────────────────────────────────────────────────────
  "kv_namespaces": [
    {
      "binding": "GABRIEL_KV",
      "id": "f205b56a9914413da0ec454a9dc4c2bd"
    },
    {
      "binding": "GABRIEL_VOICE",
      "id": "16532a32b2e8455486cc966403f3442e"
    },
    // SETUP: npx wrangler kv namespace create "FEATURE_FLAGS"
    // { "binding": "FEATURE_FLAGS", "id": "CREATE_AFTER_SETUP" },
    // SETUP: npx wrangler kv namespace create "GAP_SOLVER"
    // { "binding": "GAP_SOLVER", "id": "CREATE_AFTER_SETUP" }
  ],

  // ── Environment Variables ──────────────────────────────────────────────────
  "vars": {
    "NOIZY_ENV": "production",
    "NOIZY_VERSION": "18.0.0",
    "FOUNDING_ACTOR_FLOOR": "85",
    "STANDARD_ACTOR_FLOOR": "75",
    "VOICE_VAULT_BUCKET": "noizy-voice-vault"
  },

  // ── Observability ──────────────────────────────────────────────────────────
  "observability": {
    "enabled": true
  },

  // ── Environments ───────────────────────────────────────────────────────────
  "env": {
    "preview": {
      "name": "heaven-preview",
      "vars": {
        "NOIZY_ENV": "preview",
        "NOIZY_VERSION": "18.0.0"
      }
    },
    "canary": {
      "name": "heaven-canary",
      "vars": {
        "NOIZY_ENV": "canary",
        "NOIZY_VERSION": "18.0.0"
      }
    },
    "production": {
      "name": "heaven",
      "vars": {
        "NOIZY_ENV": "production",
        "NOIZY_VERSION": "18.0.0"
      }
    }
  }

  // ── Custom Domains (BLOCKED — waiting on noizy.ai nameserver delegation) ──
  // Uncomment ONLY after: noizy.ai zone is Active in CF dashboard
  //
  // "routes": [
  //   { "pattern": "heaven.noizy.ai", "custom_domain": true }
  // ]
}
