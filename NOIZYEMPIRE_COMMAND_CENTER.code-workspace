{
  // ═══════════════════════════════════════════════════════════════════════════
  // NOIZY EMPIRE — UNIFIED COMMAND CENTER
  // VS Code Insiders | noizybeast operational config
  // Mac Studio Mic → Talon → Gabriel → n8n → Claude Code → Deploy
  // ═══════════════════════════════════════════════════════════════════════════
  "folders": [
    { "name": "HEAVEN (live: noizylab.workers.dev)", "path": "/Users/m2ultra/Desktop/HEAVEN" },
    { "name": "NOIZYLAB", "path": "/Users/m2ultra/NOIZYLAB" },
    { "name": "noizybeast", "path": "/Users/m2ultra/NOIZYLAB/noizybeast" },
    { "name": "command-center", "path": "/Users/m2ultra/.gemini/antigravity/scratch/noizy-command-center" },
    { "name": "NOIZY-WORKERS", "path": "/Users/m2ultra/.gemini/antigravity/scratch/noizy-workers" },
    { "name": "DREAMCHAMBER", "path": "/Users/m2ultra/NOIZYLAB/dreamchamber" },
  ],

  "settings": {
    // ── Layout ─────────────────────────────────────────────────────────────
    // LEFT:   Explorer + Source Control
    // MIDDLE: Code editor (primary)
    // RIGHT:  Claude Code / Gemini chat panel
    // BOTTOM: Terminal split — n8n | Postman | Gabriel | Deploy
    "workbench.activityBar.location": "top",
    "workbench.panel.defaultLocation": "bottom",
    "workbench.editor.splitSizing": "distribute",
    "terminal.integrated.splitCwd": "workspaceRoot",

    // ── Editor ─────────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.fontFamily": "'JetBrains Mono', 'Cascadia Code', monospace",
    "editor.fontSize": 13,
    "editor.lineHeight": 1.6,
    "editor.formatOnSaveMode": "modificationsIfAvailable",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.inlineSuggest.enabled": true,

    // ── Talon / Voice ──────────────────────────────────────────────────────
    "command-server.allowList": ["*"],
    "terminal.integrated.allowMnemonics": true,
    "accessibility.signalOptions.volume": 10,
    "editor.allowVariableFontsInAccessibilityMode": true,

    // ── Spell / Brand names ────────────────────────────────────────────────
    "cSpell.allowCompoundWords": true,
    "cSpell.words": [
      "NOIZY", "NOIZYVOX", "NOIZYFISH", "NOIZYKIDZ", "NOIZYLAB",
      "noizybeast", "HEAVEN", "Gabriel", "HVS", "memcell",
      "c2pa", "C2PA", "wrangler", "Cloudflare", "Vercel",
      "XTTS", "binaural", "PREMIS", "OAIS", "anthropic",
      "myfamily", "myFamily", "noizyanthropic", "mc96eco"
    ],

    // ── Git ────────────────────────────────────────────────────────────────
    "gitlens.sortRepositoriesBy": "name:desc",
    "gitlens.sortBranchesBy": "name:desc",
    "git.autofetch": true,
    "git.enableSmartCommit": true,

    // ── TOML (wrangler.toml) ───────────────────────────────────────────────
    "evenBetterToml.formatter.compactInlineTables": true,
    "evenBetterToml.formatter.indentEntries": true,
    "evenBetterToml.formatter.indentTables": true,
    "evenBetterToml.formatter.reorderKeys": true,

    // ── MCP Servers ────────────────────────────────────────────────────────
    "mcp": {
      "servers": {
        "github": {
          "type": "http",
          "url": "https://api.githubcopilot.com/mcp/"
        },
        "github-mcp-server": {
          "type": "stdio",
          "command": "docker",
          "args": [
            "run", "-i", "--rm",
            "-e", "GITHUB_PERSONAL_ACCESS_TOKEN=${input:githubToken}",
            "ghcr.io/github/github-mcp-server:latest"
          ]
        }
      },
      "inputs": [
        {
          "id": "githubToken",
          "type": "promptString",
          "description": "GitHub Personal Access Token",
          "password": true
        }
      ]
    }
  },

  // ── Tasks — the pipeline ──────────────────────────────────────────────────
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "HEAVEN: Deploy",
        "type": "shell",
        "command": "cd /Users/m2ultra/Desktop/HEAVEN && npx wrangler deploy",
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "DEPLOY" },
        "problemMatcher": []
      },
      {
        "label": "HEAVEN: Dev (local)",
        "type": "shell",
        "command": "cd /Users/m2ultra/Desktop/HEAVEN && npx wrangler dev",
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "LOCAL" },
        "problemMatcher": []
      },
      {
        "label": "Gabriel: Health Check",
        "type": "shell",
        "command": "curl -s https://heaven.noizylab.workers.dev/api/health | python3 -m json.tool",
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "GABRIEL" },
        "problemMatcher": []
      },
      {
        "label": "Gabriel: Read Ledger (last 20)",
        "type": "shell",
        "command": "npx wrangler d1 execute gabriel_db --command \"SELECT event_type, actor_id, logged_at FROM gabriel_log ORDER BY logged_at DESC LIMIT 20\" --remote",
        "options": { "cwd": "/Users/m2ultra/Desktop/HEAVEN" },
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "GABRIEL" },
        "problemMatcher": []
      },
      {
        "label": "DB: Migrate myFamily schema",
        "type": "shell",
        "command": "cd /Users/m2ultra/Desktop/HEAVEN && npx wrangler d1 execute gabriel_db --file=./schema/001_myfamily_init.sql --remote",
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "DB" },
        "problemMatcher": []
      },
      {
        "label": "DB: List all tables in gabriel_db",
        "type": "shell",
        "command": "npx wrangler d1 execute gabriel_db --command \"SELECT name, sql FROM sqlite_master WHERE type='table' ORDER BY name\" --remote",
        "options": { "cwd": "/Users/m2ultra/Desktop/HEAVEN" },
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "DB" },
        "problemMatcher": []
      },
      {
        "label": "Postman: Test HEAVEN endpoints",
        "type": "shell",
        "command": "curl -s https://heaven.noizylab.workers.dev/api/health && curl -s -X POST https://heaven.noizylab.workers.dev/api/signup -H 'Content-Type: application/json' -d '{\"email\":\"test@noizy.ai\"}' | python3 -m json.tool",
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "POSTMAN" },
        "problemMatcher": []
      },
      {
        "label": "EMPIRE: Full status check",
        "type": "shell",
        "command": "echo '=== HEAVEN ===' && curl -s https://heaven.noizylab.workers.dev/api/health | python3 -m json.tool && echo '=== WORKERS ===' && npx wrangler workers list 2>/dev/null && echo '=== D1 ===' && npx wrangler d1 list 2>/dev/null | grep -v WARNING",
        "options": { "cwd": "/Users/m2ultra/Desktop/HEAVEN" },
        "presentation": { "reveal": "always", "panel": "dedicated", "tab": "EMPIRE" },
        "problemMatcher": []
      }
    ]
  },

  // ── Launch (debug configs) ─────────────────────────────────────────────────
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "HEAVEN: Local Worker Debug",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npx",
        "runtimeArgs": ["wrangler", "dev", "--inspector-port", "9229"],
        "cwd": "/Users/m2ultra/Desktop/HEAVEN",
        "skipFiles": ["<node_internals>/**"]
      }
    ]
  }
}
