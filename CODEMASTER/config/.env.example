# ═══════════════════════════════════════════════════════════════
# CODEMASTER .env.example
# Copy to .env and fill in real values
# RSP_001 | NOIZY Empire | 2026
# ═══════════════════════════════════════════════════════════════

# GABRIEL daemon
GABRIEL_URL=http://localhost:7777

# HEAVEN (Cloudflare Worker)
HEAVEN_URL=https://heaven.noizylab.workers.dev
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token

# n8n governance orchestrator
N8N_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=noizylab
N8N_BASIC_AUTH_PASSWORD=change-this-password

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_STATUS_URL=https://status.claude.com/api/v2/status.json

# Slack (audit channel webhook)
SLACK_AUDIT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Notion
NOTION_API_KEY=ntn_xxxxx
NOTION_WORKSPACE_ID=xxxxx

# WireGuard VPN
WG_ENDPOINT=your-server-ip:51820

# Operator
OPERATOR_ID=RSP_001
