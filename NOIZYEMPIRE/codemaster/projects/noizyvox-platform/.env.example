NOIZYVOX_ENV=development
NOIZYVOX_DB_URL=sqlite:///./data/noizyvox.db
NOIZYVOX_API_PREFIX=/api/v1
NOIZYVOX_DEBUG=true
NOIZYVOX_AUTH_ENABLED=true
NOIZYVOX_API_TOKENS=local-dev-token
NOIZYVOX_ADMIN_TOKENS=local-admin-token
NOIZYVOX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NOIZYVOX_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
NOIZYVOX_MAX_BODY_BYTES=1048576
NOIZYVOX_FORCE_HTTPS=false
