# =====================================================
# GABRIEL MCP CREDENTIALS TEMPLATE
# =====================================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git!
# =====================================================

# -----------------------------------------------------
# GITHUB
# Get token: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user, workflow
# -----------------------------------------------------
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------
# GOOGLE WORKSPACE
# Setup: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Desktop app type)
# Enable APIs: Gmail, Calendar, Drive, Docs, Sheets, Slides
# -----------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------
# GOOGLE AI STUDIO (GEMINI)
# Get key: https://aistudio.google.com/app/apikey
# -----------------------------------------------------
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------
# SLACK
# Create app: https://api.slack.com/apps
# Add Bot Token Scopes: channels:read, chat:write, search:read
# Install to workspace, copy Bot User OAuth Token
# Team ID: Workspace settings > About this workspace
# -----------------------------------------------------
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_TEAM_ID=Txxxxxxxxxx

# -----------------------------------------------------
# DISCORD
# Create bot: https://discord.com/developers/applications
# Bot > Token (Reset Token to get it)
# Required Permissions: Send Messages, Read Message History
# Invite URL: OAuth2 > URL Generator
# -----------------------------------------------------
DISCORD_TOKEN=MTxxxxxxxxxxxxxxxxxxxxxxx.Gxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------
# BRAVE SEARCH (Optional - for web search)
# Get key: https://brave.com/search/api/
# -----------------------------------------------------
BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
