#!/usr/bin/env python3
"""
GABRIEL - NOIZY.AI AI Agent Commander
=====================================
The central command interface for all NOIZY.AI AI operations.

Usage:
    gabriel status          - Check all MCP server status
    gabriel mcp             - List available MCP servers
    gabriel launch          - Launch Claude Desktop with MCP
    gabriel test            - Test all connections
    gabriel gemini <prompt> - Quick Gemini query
    gabriel slack <msg>     - Send Slack message
    gabriel github <repo>   - Check GitHub repo
    gabriel help            - Show this help

Author: R.S. Plowman
Motto: GORUNFREE!!
"""

import sys
import os
import subprocess
import json
from pathlib import Path

# Colors
class C:
    GREEN = '\033[92m'
    RED = '\033[91m'
    YELLOW = '\033[93m'
    BLUE = '\033[94m'
    MAGENTA = '\033[95m'
    CYAN = '\033[96m'
    BOLD = '\033[1m'
    END = '\033[0m'

def banner():
    print(f"""
{C.CYAN}╔═══════════════════════════════════════════════════════════════╗
║  {C.BOLD}GABRIEL{C.END}{C.CYAN} - NOIZY.AI AI Agent Commander                        ║
║  {C.YELLOW}GORUNFREE!!{C.CYAN}                                                   ║
╚═══════════════════════════════════════════════════════════════╝{C.END}
""")

def check_env(name):
    """Check if environment variable is set"""
    val = os.environ.get(name, "")
    if val and not val.startswith("${") and val != "":
        return True
    return False

def cmd_status():
    """Check status of all MCP servers and credentials"""
    banner()
    print(f"{C.BOLD}📊 MCP SERVER STATUS{C.END}\n")

    # Check credentials
    creds = {
        "GITHUB_TOKEN": "GitHub",
        "GOOGLE_OAUTH_CLIENT_ID": "Google Workspace",
        "GEMINI_API_KEY": "Google AI Studio",
        "SLACK_BOT_TOKEN": "Slack",
        "DISCORD_TOKEN": "Discord",
        "BRAVE_API_KEY": "Brave Search"
    }

    print(f"{C.BOLD}Credentials:{C.END}")
    for env, name in creds.items():
        status = f"{C.GREEN}✅ Configured{C.END}" if check_env(env) else f"{C.RED}❌ Missing{C.END}"
        print(f"  {name:20} {status}")

    # Check Docker
    print(f"\n{C.BOLD}Services:{C.END}")
    docker_running = subprocess.run(["docker", "info"], capture_output=True).returncode == 0
    print(f"  Docker:              {C.GREEN}✅ Running{C.END}" if docker_running else f"  Docker:              {C.RED}❌ Not running{C.END}")

    # Check uvx
    uvx_ok = subprocess.run(["which", "uvx"], capture_output=True).returncode == 0
    print(f"  uvx:                 {C.GREEN}✅ Available{C.END}" if uvx_ok else f"  uvx:                 {C.RED}❌ Not found{C.END}")

    # Check npx
    npx_ok = subprocess.run(["which", "npx"], capture_output=True).returncode == 0
    print(f"  npx:                 {C.GREEN}✅ Available{C.END}" if npx_ok else f"  npx:                 {C.RED}❌ Not found{C.END}")

    print(f"\n{C.YELLOW}💡 Run 'gabriel help' for available commands{C.END}")

def cmd_mcp():
    """List available MCP servers"""
    banner()
    print(f"{C.BOLD}🔌 AVAILABLE MCP SERVERS{C.END}\n")

    servers = [
        ("filesystem", "File operations", "npx", "✅"),
        ("memory", "Persistent memory", "npx", "✅"),
        ("github", "GitHub integration", "docker", "⚙️ Needs token"),
        ("google-workspace", "Gmail, Calendar, Drive", "uvx", "⚙️ Needs OAuth"),
        ("google-ai-studio", "Gemini 2.5 AI", "uvx", "⚙️ Needs key"),
        ("fetch", "Web fetching", "uvx", "✅"),
        ("git", "Git operations", "uvx", "✅"),
        ("time", "Time/timezone", "uvx", "✅"),
        ("sqlite", "SQLite database", "uvx", "✅"),
        ("sequential-thinking", "Advanced reasoning", "npx", "✅"),
    ]

    print(f"{'Server':<25} {'Purpose':<25} {'Runtime':<10} {'Status'}")
    print("─" * 75)
    for name, purpose, runtime, status in servers:
        print(f"{name:<25} {purpose:<25} {runtime:<10} {status}")

def cmd_launch():
    """Launch Claude Desktop"""
    banner()
    print(f"{C.CYAN}🚀 Launching Claude Desktop...{C.END}")
    subprocess.run(["open", "-a", "Claude"])
    print(f"{C.GREEN}✅ Claude Desktop launched!{C.END}")

def cmd_test():
    """Test all MCP server connections"""
    banner()
    print(f"{C.BOLD}🧪 TESTING MCP SERVERS{C.END}\n")

    tests = [
        ("uvx mcp-server-fetch --help", "Fetch"),
        ("uvx mcp-server-git --help", "Git"),
        ("uvx mcp-server-time --help", "Time"),
        ("uvx mcp-server-sqlite --help", "SQLite"),
        ("uvx workspace-mcp --help", "Google Workspace"),
        ("docker images | grep github-mcp", "GitHub Docker"),
    ]

    for cmd, name in tests:
        result = subprocess.run(cmd, shell=True, capture_output=True)
        status = f"{C.GREEN}✅ OK{C.END}" if result.returncode == 0 else f"{C.RED}❌ FAIL{C.END}"
        print(f"  {name:<20} {status}")

    print(f"\n{C.GREEN}🎉 Testing complete!{C.END}")

def cmd_help():
    """Show help"""
    banner()
    print(__doc__)

def main():
    if len(sys.argv) < 2:
        cmd_status()
        return

    cmd = sys.argv[1].lower()

    commands = {
        "status": cmd_status,
        "mcp": cmd_mcp,
        "launch": cmd_launch,
        "test": cmd_test,
        "help": cmd_help,
        "-h": cmd_help,
        "--help": cmd_help,
    }

    if cmd in commands:
        commands[cmd]()
    else:
        print(f"{C.RED}Unknown command: {cmd}{C.END}")
        print(f"Run 'gabriel help' for available commands")
        sys.exit(1)

if __name__ == "__main__":
    main()
