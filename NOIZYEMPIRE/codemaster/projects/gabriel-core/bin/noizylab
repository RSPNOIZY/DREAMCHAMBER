#!/bin/bash
# ═══════════════════════════════════════════════════════════════════════════════
# NOIZYLAB MASTER COMMAND CENTER
# One command to rule them all
# ═══════════════════════════════════════════════════════════════════════════════

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

NOIZYLAB_ROOT="$HOME/NOIZYLAB"
GABRIEL_CORE="$NOIZYLAB_ROOT/CODEMASTER/projects/gabriel-core"
GABRIEL_SYSTEM="$NOIZYLAB_ROOT/gabriel-system"
CODE_ROOT="$NOIZYLAB_ROOT/CODE"

banner() {
    echo -e "${CYAN}"
    echo "╔═══════════════════════════════════════════════════════════════╗"
    echo "║  ${BOLD}NOIZYLAB${NC}${CYAN} - AI Command Center                               ║"
    echo "║  ${YELLOW}MC96DIGIUNIVERSE • GORUNFREE!!${CYAN}                             ║"
    echo "╚═══════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

cmd_status() {
    banner
    echo -e "${BOLD}📊 SYSTEM STATUS${NC}\n"

    # Check symlinks
    echo -e "${BOLD}Symlinks:${NC}"
    [[ -L "$NOIZYLAB_ROOT/gabriel-system" ]] && echo -e "  ${GREEN}✅${NC} gabriel-system" || echo -e "  ${RED}❌${NC} gabriel-system"
    [[ -L "$NOIZYLAB_ROOT/CODE" ]] && echo -e "  ${GREEN}✅${NC} CODE" || echo -e "  ${RED}❌${NC} CODE"
    [[ -L "$NOIZYLAB_ROOT/MC96" ]] && echo -e "  ${GREEN}✅${NC} MC96" || echo -e "  ${RED}❌${NC} MC96"

    # Check services
    echo -e "\n${BOLD}Services:${NC}"
    docker info &>/dev/null && echo -e "  ${GREEN}✅${NC} Docker" || echo -e "  ${RED}❌${NC} Docker"
    which uvx &>/dev/null && echo -e "  ${GREEN}✅${NC} uvx" || echo -e "  ${RED}❌${NC} uvx"
    which npx &>/dev/null && echo -e "  ${GREEN}✅${NC} npx" || echo -e "  ${RED}❌${NC} npx"
    which node &>/dev/null && echo -e "  ${GREEN}✅${NC} node" || echo -e "  ${RED}❌${NC} node"

    # Check credentials
    echo -e "\n${BOLD}Credentials:${NC}"
    [[ -n "$GITHUB_TOKEN" && "$GITHUB_TOKEN" != '${GITHUB_TOKEN}' ]] && echo -e "  ${GREEN}✅${NC} GITHUB_TOKEN" || echo -e "  ${RED}❌${NC} GITHUB_TOKEN"
    [[ -n "$GEMINI_API_KEY" ]] && echo -e "  ${GREEN}✅${NC} GEMINI_API_KEY" || echo -e "  ${RED}❌${NC} GEMINI_API_KEY"
    [[ -n "$CLOUDFLARE_API_TOKEN" ]] && echo -e "  ${GREEN}✅${NC} CLOUDFLARE_API_TOKEN" || echo -e "  ${RED}❌${NC} CLOUDFLARE_API_TOKEN"

    # Check database
    echo -e "\n${BOLD}Database:${NC}"
    [[ -f "$NOIZYLAB_ROOT/gabriel.db" ]] && echo -e "  ${GREEN}✅${NC} gabriel.db ($(du -h "$NOIZYLAB_ROOT/gabriel.db" | cut -f1))" || echo -e "  ${RED}❌${NC} gabriel.db"
}

cmd_mcp() {
    banner
    echo -e "${BOLD}🔌 MCP SERVERS${NC}\n"

    echo "Configured in Claude Desktop:"
    echo "  filesystem          File operations"
    echo "  memory              Persistent memory"
    echo "  github              Code, Issues, PRs"
    echo "  google-workspace    Gmail, Calendar, Drive"
    echo "  google-ai-studio    Gemini 2.5"
    echo "  fetch               Web fetching"
    echo "  git                 Git operations"
    echo "  time                Time/timezone"
    echo "  sqlite              Database"
    echo "  sequential-thinking Advanced reasoning"
    echo "  gabriel             8 custom tools"
    echo "  ekkos               28-tool memory system"
    echo "  cloudflare          Workers, D1, KV"
    echo "  noizylab-unified    AI Command Center!"
    echo ""
    echo "Total: 14 MCP servers"
}

cmd_magic() {
    banner
    echo -e "${BOLD}🪄 ALL THE MAGIC${NC}\n"

    echo -e "${CYAN}Discovered Resources:${NC}"
    echo "  • gabriel-system    Full Gabriel AI + MCP servers"
    echo "  • CODE              30,000+ files master repo"
    echo "  • MC96              MC96ECOUNIVERSE"
    echo "  • ekkOS             28-tool memory (189 tables!)"
    echo "  • THE AQUARIUM      34TB creative archive"
    echo ""

    echo -e "${CYAN}AI Services Available:${NC}"
    echo "  • Runway Gen-3      Video generation"
    echo "  • Kling AI          Video generation"
    echo "  • Pika              Video generation"
    echo "  • Suno              Music generation"
    echo "  • Udio              Music generation"
    echo "  • ElevenLabs        Voice synthesis"
    echo "  • HeyGen            Avatar creation"
    echo "  • OpenAI            GPT models"
    echo "  • Anthropic         Claude models"
    echo ""

    echo -e "${CYAN}Systems Online:${NC}"
    echo "  • GABRIEL Core      ∞ energy"
    echo "  • Brain Systems     ∞ energy"
    echo "  • MCP Servers       14 active"
    echo "  • AI Agents         Ready"
}

cmd_launch() {
    banner
    echo -e "${CYAN}🚀 Launching Claude Desktop...${NC}"
    open -a Claude
    echo -e "${GREEN}✅ Claude Desktop launched!${NC}"
}

cmd_gorunfree() {
    if [[ -x "$CODE_ROOT/gabriel/gorunfree" ]]; then
        "$CODE_ROOT/gabriel/gorunfree" "$@"
    else
        echo -e "${RED}gorunfree script not found${NC}"
    fi
}

cmd_gabriel() {
    "$GABRIEL_CORE/bin/gabriel" "$@"
}

cmd_help() {
    banner
    echo -e "${BOLD}Usage:${NC} noizylab [command] [options]"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  status      Show full system status"
    echo "  mcp         List all MCP servers"
    echo "  magic       Show discovered magic"
    echo "  launch      Open Claude Desktop"
    echo "  gabriel     Run Gabriel commands"
    echo "  gorunfree   Run gorunfree commands"
    echo "  help        Show this help"
    echo ""
    echo -e "${YELLOW}GORUNFREE!!${NC} 🚀"
}

# Main
case "${1:-status}" in
    status)   cmd_status ;;
    mcp)      cmd_mcp ;;
    magic)    cmd_magic ;;
    launch)   cmd_launch ;;
    gabriel)  shift; cmd_gabriel "$@" ;;
    gorunfree) shift; cmd_gorunfree "$@" ;;
    help|-h|--help) cmd_help ;;
    *)        echo "Unknown command: $1"; cmd_help ;;
esac
