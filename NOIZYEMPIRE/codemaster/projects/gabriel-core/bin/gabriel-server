#!/usr/bin/env python3
"""
GABRIEL MCP SERVER
==================
Local MCP server that provides Gabriel-specific tools to Claude Desktop.

Run with: gabriel-server
Or add to Claude Desktop config.

Author: R.S. Plowman / NOIZY.AI
Motto: GORUNFREE!!
"""

import sys
import json
import sqlite3
import os
from datetime import datetime
from pathlib import Path

# Add parent to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent / "mcp"))

DB_PATH = str(Path.home() / "NOIZYLAB" / "gabriel.db")


def get_db():
    """Get database connection"""
    return sqlite3.connect(DB_PATH)


def handle_tool_call(tool_name: str, arguments: dict) -> dict:
    """Handle MCP tool calls"""

    if tool_name == "gabriel_remember":
        # Store something in memory
        key = arguments.get("key")
        value = arguments.get("value")
        category = arguments.get("category", "general")

        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("""
            INSERT OR REPLACE INTO gabriel_memory (key, value, category, updated_at)
            VALUES (?, ?, ?, ?)
        """, (key, value, category, datetime.now().isoformat()))
        conn.commit()
        conn.close()

        return {"success": True, "message": f"Remembered: {key}"}

    elif tool_name == "gabriel_recall":
        # Recall from memory
        key = arguments.get("key")

        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("SELECT value, category FROM gabriel_memory WHERE key = ?", (key,))
        row = cursor.fetchone()
        conn.close()

        if row:
            return {"success": True, "value": row[0], "category": row[1]}
        return {"success": False, "message": "Not found"}

    elif tool_name == "gabriel_list_memories":
        # List all memories
        category = arguments.get("category")

        conn = get_db()
        cursor = conn.cursor()
        if category:
            cursor.execute("SELECT key, category, created_at FROM gabriel_memory WHERE category = ?", (category,))
        else:
            cursor.execute("SELECT key, category, created_at FROM gabriel_memory")
        rows = cursor.fetchall()
        conn.close()

        return {"success": True, "memories": [{"key": r[0], "category": r[1], "created_at": r[2]} for r in rows]}

    elif tool_name == "gabriel_add_task":
        # Add a task
        description = arguments.get("description")
        priority = arguments.get("priority", 5)
        task_id = f"task_{datetime.now().strftime('%Y%m%d_%H%M%S')}"

        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO gabriel_tasks (task_id, description, priority)
            VALUES (?, ?, ?)
        """, (task_id, description, priority))
        conn.commit()
        conn.close()

        return {"success": True, "task_id": task_id}

    elif tool_name == "gabriel_complete_task":
        # Complete a task
        task_id = arguments.get("task_id")
        result = arguments.get("result", "")

        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("""
            UPDATE gabriel_tasks
            SET status = 'completed', completed_at = ?, result = ?
            WHERE task_id = ?
        """, (datetime.now().isoformat(), result, task_id))
        conn.commit()
        conn.close()

        return {"success": True, "message": f"Task {task_id} completed"}

    elif tool_name == "gabriel_list_tasks":
        # List tasks
        status = arguments.get("status", "pending")

        conn = get_db()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT task_id, description, priority, status, created_at
            FROM gabriel_tasks
            WHERE status = ?
            ORDER BY priority DESC, created_at DESC
        """, (status,))
        rows = cursor.fetchall()
        conn.close()

        return {"success": True, "tasks": [
            {"task_id": r[0], "description": r[1], "priority": r[2], "status": r[3], "created_at": r[4]}
            for r in rows
        ]}

    elif tool_name == "gabriel_mc96_status":
        # Get MC96 network status
        conn = get_db()
        cursor = conn.cursor()

        cursor.execute("SELECT COUNT(*) FROM mc96_requests")
        request_count = cursor.fetchone()[0]

        cursor.execute("SELECT AVG(latency_ms) FROM mc96_requests WHERE latency_ms IS NOT NULL")
        avg_latency = cursor.fetchone()[0] or 0

        conn.close()

        return {
            "success": True,
            "hub": "DGS1210-10",
            "ports": 8,
            "total_requests": request_count,
            "avg_latency_ms": round(avg_latency, 2)
        }

    elif tool_name == "gabriel_status":
        # Get overall Gabriel status
        conn = get_db()
        cursor = conn.cursor()

        cursor.execute("SELECT COUNT(*) FROM gabriel_memory")
        memory_count = cursor.fetchone()[0]

        cursor.execute("SELECT COUNT(*) FROM gabriel_tasks WHERE status = 'pending'")
        pending_tasks = cursor.fetchone()[0]

        cursor.execute("SELECT COUNT(*) FROM gabriel_mcp_logs")
        mcp_calls = cursor.fetchone()[0]

        conn.close()

        return {
            "success": True,
            "memories": memory_count,
            "pending_tasks": pending_tasks,
            "mcp_calls": mcp_calls,
            "status": "operational",
            "motto": "GORUNFREE!!"
        }

    else:
        return {"success": False, "error": f"Unknown tool: {tool_name}"}


def main():
    """Run as MCP server (stdio mode)"""
    # MCP tools definition
    tools = [
        {
            "name": "gabriel_remember",
            "description": "Store something in Gabriel's persistent memory",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "key": {"type": "string", "description": "Memory key"},
                    "value": {"type": "string", "description": "Value to remember"},
                    "category": {"type": "string", "description": "Category (optional)"}
                },
                "required": ["key", "value"]
            }
        },
        {
            "name": "gabriel_recall",
            "description": "Recall something from Gabriel's memory",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "key": {"type": "string", "description": "Memory key to recall"}
                },
                "required": ["key"]
            }
        },
        {
            "name": "gabriel_list_memories",
            "description": "List all memories, optionally filtered by category",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "category": {"type": "string", "description": "Filter by category (optional)"}
                }
            }
        },
        {
            "name": "gabriel_add_task",
            "description": "Add a task to Gabriel's task list",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "description": {"type": "string", "description": "Task description"},
                    "priority": {"type": "integer", "description": "Priority 1-10 (10 highest)"}
                },
                "required": ["description"]
            }
        },
        {
            "name": "gabriel_complete_task",
            "description": "Mark a task as completed",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "task_id": {"type": "string", "description": "Task ID"},
                    "result": {"type": "string", "description": "Result/notes"}
                },
                "required": ["task_id"]
            }
        },
        {
            "name": "gabriel_list_tasks",
            "description": "List tasks by status",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "status": {"type": "string", "description": "Task status (pending, completed)"}
                }
            }
        },
        {
            "name": "gabriel_mc96_status",
            "description": "Get MC96 network hub status",
            "inputSchema": {"type": "object", "properties": {}}
        },
        {
            "name": "gabriel_status",
            "description": "Get overall Gabriel system status",
            "inputSchema": {"type": "object", "properties": {}}
        }
    ]

    # Print capabilities for testing
    if len(sys.argv) > 1 and sys.argv[1] == "--info":
        print(json.dumps({"tools": tools}, indent=2))
        return

    # Run in stdio mode
    print(f"GABRIEL MCP Server running", file=sys.stderr)
    print(f"Tools: {len(tools)}", file=sys.stderr)
    print(f"DB: {DB_PATH}", file=sys.stderr)

    for line in sys.stdin:
        try:
            request = json.loads(line.strip())
            if request.get("method") == "tools/list":
                response = {"tools": tools}
            elif request.get("method") == "tools/call":
                tool_name = request.get("params", {}).get("name")
                arguments = request.get("params", {}).get("arguments", {})
                result = handle_tool_call(tool_name, arguments)
                response = {"content": [{"type": "text", "text": json.dumps(result)}]}
            else:
                response = {"error": "Unknown method"}

            print(json.dumps(response))
            sys.stdout.flush()
        except Exception as e:
            print(json.dumps({"error": str(e)}))
            sys.stdout.flush()


if __name__ == "__main__":
    main()
