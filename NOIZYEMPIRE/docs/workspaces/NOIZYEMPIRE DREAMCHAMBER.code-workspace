			"FIXME",
			"HACK",
			"NOTE"
		],
		"todo-tree.highlights.defaultHighlight": {
			"type": "tag",
			"gutterIcon": true
		},
		"todo-tree.highlights.customHighlight": {
			"NOIZY": {
				"foreground": "#00ffcc",
				"background": "#00ffcc22",
				"iconColour": "#00ffcc",
