{
  "folders": [
    {
      "name": "🎙 DREAMCHAMBER — VSCode Extension",
      "path": "dreamchamber-extension"
    },
    {
      "name": "🐍 NOIZY PLATFORM — FastAPI Backend",
      "path": "noizy_platform"
    },
    {
      "name": "💎 NOIZYVOX — Voice Registry Root",
      "path": "."
    },
    {
      "name": "🎵 GABRIEL — Orchestrator DB",
      "path": "GABRIEL"
    },
    {
      "name": "🎭 RSP_001 — Recording Pipeline",
      "path": "rsp001_pipeline"
    }
  ],

  "settings": {
    // ── Python ──────────────────────────────────────────────────────────────
    "python.defaultInterpreterPath": "${workspaceFolder:🐍 NOIZY PLATFORM — FastAPI Backend}/.venv/bin/python",
    "python.analysis.extraPaths": [
      "${workspaceFolder:🐍 NOIZY PLATFORM — FastAPI Backend}"
    ],

    // ── TypeScript ───────────────────────────────────────────────────────────
    "typescript.tsdk": "${workspaceFolder:🎙 DREAMCHAMBER — VSCode Extension}/node_modules/typescript/lib",

    // ── Editor ───────────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // ── File associations ────────────────────────────────────────────────────
    "files.associations": {
      "*.wav": "binary",
      "*.mp3": "binary",
      "*.pt":  "binary",
      "*.ckpt": "binary"
    },

    // ── Audio file exclusions (keep workspace fast) ───────────────────────────
    "files.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.venv": true,
      "**/*.pyc": true,
      "**/noizy_platform.db": false,
      "**/.cache": true
    },

    // ── Search exclusions ─────────────────────────────────────────────────────
    "search.exclude": {
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.venv": true,
      "**/out": true
    },

    // ── DreamChamber extension settings ──────────────────────────────────────
    "dreamchamber.anthropicApiKey": "",
    "dreamchamber.ttsEngine": "say",
    "dreamchamber.sayVoice": "Samantha",
    "dreamchamber.transcriptionEngine": "whisper-api",
    "dreamchamber.kokoroUrl": "http://localhost:8880",
    "dreamchamber.musicgenUrl": "http://localhost:7860",
    "dreamchamber.aceStepUrl": "http://localhost:7861",
    "dreamchamber.mmAudioUrl": "http://localhost:7862",

    // ── NOIZYVOX settings ────────────────────────────────────────────────────
    "dreamchamber.noizyVoxUrl": "http://localhost:8090",
    "dreamchamber.noizyVoxApiKey": "noizy-dev",
    "dreamchamber.xttsVoiceSlug": "",
    "dreamchamber.xttsLanguage": "en",
    "dreamchamber.xttsSpeed": 1.0,

    // ── Terminal ─────────────────────────────────────────────────────────────
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.env.osx": {
      "NOIZY_API_KEY": "noizy-dev",
      "NOIZYVOX_VOICES_DIR": "${env:HOME}/.noizy/voices",
      "ANTHROPIC_API_KEY": "${env:ANTHROPIC_API_KEY}"
    }
  },

  "tasks": {
    "version": "2.0.0",
    "tasks": [
      // ── Platform: start FastAPI backend ────────────────────────────────────
      {
        "label": "🐍 Start NOIZY Platform",
        "type": "shell",
        "command": "source .venv/bin/activate && uvicorn app.main:app --reload --port 8090 --host 0.0.0.0",
        "options": {
          "cwd": "${workspaceFolder:🐍 NOIZY PLATFORM — FastAPI Backend}"
        },
        "group": "build",
        "presentation": {
          "group": "noizy-services",
          "panel": "dedicated",
          "reveal": "always"
        },
        "isBackground": true,
        "problemMatcher": []
      },

      // ── Platform: install Python deps ──────────────────────────────────────
      {
        "label": "🐍 Install Platform Dependencies",
        "type": "shell",
        "command": "python3 -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt",
        "options": {
          "cwd": "${workspaceFolder:🐍 NOIZY PLATFORM — FastAPI Backend}"
        },
        "group": "build",
        "presentation": { "panel": "dedicated", "reveal": "always" }
      },

      // ── Platform: install XTTS + PyTorch (M2 Ultra) ────────────────────────
      {
        "label": "⚡ Install XTTS + PyTorch (M2 Ultra)",
        "type": "shell",
        "command": "source .venv/bin/activate && pip install TTS && pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu && pip install speechbrain transformers datasets",
        "options": {
          "cwd": "${workspaceFolder:🐍 NOIZY PLATFORM — FastAPI Backend}"
        },
        "group": "build",
        "presentation": { "panel": "dedicated", "reveal": "always" }
      },

      // ── Extension: build DreamChamber ──────────────────────────────────────
      {
        "label": "🎙 Build DreamChamber Extension",
        "type": "npm",
        "script": "compile",
        "options": {
          "cwd": "${workspaceFolder:🎙 DREAMCHAMBER — VSCode Extension}"
        },
        "group": "build",
        "presentation": { "panel": "shared", "reveal": "silent" },
        "problemMatcher": ["$tsc"]
      },

      // ── Extension: watch mode ──────────────────────────────────────────────
      {
        "label": "🎙 Watch DreamChamber Extension",
        "type": "npm",
        "script": "watch",
        "options": {
          "cwd": "${workspaceFolder:🎙 DREAMCHAMBER — VSCode Extension}"
        },
        "group": "build",
        "isBackground": true,
        "presentation": {
          "group": "noizy-services",
          "panel": "dedicated",
          "reveal": "silent"
        },
        "problemMatcher": ["$tsc-watch"]
      },

      // ── NOIZYVOX: check status ─────────────────────────────────────────────
      {
        "label": "💎 Check NOIZYVOX Status",
        "type": "shell",
        "command": "curl -s -H 'x-noizy-api-key: noizy-dev' http://localhost:8090/noizyvox/status | python3 -m json.tool",
        "presentation": { "panel": "shared", "reveal": "always" }
      },

      // ── NOIZYVOX: list voice models ────────────────────────────────────────
      {
        "label": "💎 List Voice Models",
        "type": "shell",
        "command": "curl -s -H 'x-noizy-api-key: noizy-dev' http://localhost:8090/noizyvox/models | python3 -m json.tool",
        "presentation": { "panel": "shared", "reveal": "always" }
      },

      // ── Full stack: start everything ──────────────────────────────────────
      {
        "label": "🚀 START NOIZY SUPERSTACK",
        "dependsOn": [
          "🐍 Start NOIZY Platform",
          "🎙 Watch DreamChamber Extension"
        ],
        "group": { "kind": "build", "isDefault": true },
        "presentation": { "reveal": "always" }
      }
    ]
  },

  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🎙 Launch DreamChamber Extension",
        "type": "extensionHost",
        "request": "launch",
        "args": [
          "--extensionDevelopmentPath=${workspaceFolder:🎙 DREAMCHAMBER — VSCode Extension}"
        ],
        "outFiles": [
          "${workspaceFolder:🎙 DREAMCHAMBER — VSCode Extension}/out/**/*.js"
        ],
        "preLaunchTask": "🎙 Build DreamChamber Extension"
      },
      {
        "name": "🐍 Debug NOIZY Platform",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": ["app.main:app", "--reload", "--port", "8090"],
        "cwd": "${workspaceFolder:🐍 NOIZY PLATFORM — FastAPI Backend}",
        "env": {
          "NOIZY_API_KEY": "noizy-dev",
          "NOIZYVOX_VOICES_DIR": "${env:HOME}/.noizy/voices"
        }
      }
    ]
  },

  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.black-formatter",
      "charliermarsh.ruff",
      "ms-vscode.vscode-typescript-next",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "ms-vscode.live-server",
      "humao.rest-client"
    ]
  }
}
