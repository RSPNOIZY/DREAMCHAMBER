    },
    {
      "id": "spread",
      "meaning": "widen the room",
      "audio_effect": "ensemble bloom, stereo spread, harmonic lift"
    },
    {
      "id": "wrist_rotate",
      "meaning": "inflect or bend",
      "audio_effect": "modal color, filter tilt, ornament depth"
    },
    {
      "id": "lift",
